{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opebingo",
  "main": "cloudflare-worker.js",
  "build": {
    "command": "node scripts/prepare-bingo-recovery-seed.cjs"
  },
  "compatibility_date": "2026-07-08",
  "routes": [
    {
      "pattern": "www.opebingo.com/*",
      "zone_name": "opebingo.com"
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MURDER_MYSTERY_STATE",
        "class_name": "MurderMysteryState"
      },
      {
        "name": "BINGO_LIVE_STATE",
        "class_name": "BingoLiveState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "murder-mystery-v1",
      "new_sqlite_classes": ["MurderMysteryState"]
    },
    {
      "tag": "bingo-live-state-v1",
      "new_sqlite_classes": ["BingoLiveState"]
    }
  ],
  "vars": {
    "PUBLIC_JOIN_URL": "https://www.opebingo.com/play",
    "NEXT_PUBLIC_SUPABASE_URL": "https://tmnstuthbllnoqgepotn.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_G74TdOYv0R0AML1WZTfxJQ_YZqJa7jE"
  }
}
